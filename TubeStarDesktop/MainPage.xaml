<UserControl x:Class="TubeStar.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:TubeStar">

    <Grid x:Name="LayoutRoot" Background="#0F0F0F">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="46" />
        </Grid.RowDefinitions>

        <!-- Barra Superior de Navegação Estilo YouTube Dark -->
        <Border Grid.Row="0" Background="#1F1F1F" BorderBrush="#383838" BorderThickness="0,0,0,1" Padding="6,2">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="btnDailyPlanner" IsChecked="True" Margin="4,0" Click="btnDailyPlanner_Click">
                        <ToggleButton.Content>
                            <WrapPanel VerticalAlignment="Center">
                                <Image Source="/Resources/Home_icon.png" Margin="0,0,6,0" Height="16" Width="16" />
                                <TextBlock x:Name="txtDailyPlanner" Text="Daily Planner" VerticalAlignment="Center"/>
                            </WrapPanel>
                        </ToggleButton.Content>
                    </ToggleButton>

                    <ToggleButton x:Name="btnVideoPlanner" Margin="4,0" Click="btnVideoPlanner_Click">
                        <ToggleButton.Content>
                            <WrapPanel VerticalAlignment="Center">
                                <Image Source="/Resources/Video_icon.png" Margin="0,0,6,0" Height="16" Width="16" />
                                <TextBlock x:Name="txtVideoPlanner" Text="Video Manager" VerticalAlignment="Center"/>
                            </WrapPanel>
                        </ToggleButton.Content>
                    </ToggleButton>

                    <ToggleButton x:Name="btnOnlineStore" Margin="4,0" Click="btnOnlineStore_Click">
                        <ToggleButton.Content>
                            <WrapPanel VerticalAlignment="Center">
                                <Image Source="/Resources/Cart_icon.png" Margin="0,0,6,0" Height="16" Width="16" />
                                <TextBlock x:Name="txtOnlineStore" Text="Online Store" VerticalAlignment="Center" />
                            </WrapPanel>
                        </ToggleButton.Content>
                    </ToggleButton>

                    <ToggleButton x:Name="btnRivals" Margin="4,0" Click="btnRivals_Click">
                        <ToggleButton.Content>
                            <WrapPanel VerticalAlignment="Center">
                                <Image Source="/Resources/Rivals_icon.png" Margin="0,0,6,0" Height="16" Width="16" />
                                <TextBlock x:Name="txtRivals" Text="Rivals" VerticalAlignment="Center" />
                            </WrapPanel>
                        </ToggleButton.Content>
                    </ToggleButton>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#282828" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                        <TextBlock x:Name="txtMoney" FontSize="15" FontWeight="Bold" Foreground="#2BA640" Text="$1,000.00" VerticalAlignment="Center" />
                    </Border>
                    <Image x:Name="imgSave" Source="Resources/Disk.png" Height="22" Width="22" Margin="4,0" MouseLeftButtonDown="Save_MouseLeftButtonDown" Style="{StaticResource TriggerClickStyle}" MouseEnter="imgSave_MouseEnter" MouseLeave="imgSave_MouseLeave" Cursor="Hand"/>
                    <Image x:Name="gridHelp" Source="Resources/Help.png" Height="22" Width="22" Margin="4,0" MouseLeftButtonDown="Tutorial_MouseLeftButtonDown" Style="{StaticResource TriggerClickStyle}" MouseEnter="gridHelp_MouseEnter" MouseLeave="gridHelp_MouseLeave" Cursor="Hand"/>
                    <Image x:Name="gridExit" Source="Resources/Exit.png" Height="22" Width="22" Margin="4,0" MouseLeftButtonDown="Exit_MouseLeftButtonDown" Style="{StaticResource TriggerClickStyle}" MouseEnter="gridExit_MouseEnter" MouseLeave="gridExit_MouseLeave" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Barra Inferior do Novo Dia Estilo YouTube Red -->
        <Border Grid.Row="2" Background="#1F1F1F" BorderBrush="#383838" BorderThickness="0,1,0,0" Padding="6,4">
            <Button FontSize="18" Click="btnNewDay_Click" Background="#CC0000" Foreground="White" BorderThickness="0">
                <Button.Content>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Resources/Play_icon.png" Margin="0,0,8,0" Height="18" Width="18" />
                        <TextBlock x:Name="txtNewDay" VerticalAlignment="Center" FontWeight="Bold" Foreground="White"/>
                        <ProgressBar x:Name="progress" IsIndeterminate="True" Width="160" Margin="10,0,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Button.Content>
            </Button>
        </Border>

        <local:DailyPlanner Grid.Row="1" x:Name="dailyPlanner" />
        <local:VideoManagerControl Grid.Row="1" x:Name="videoManager" Visibility="Collapsed" />
        <local:OnlineStoreControl Grid.Row="1" x:Name="onlineStore" Visibility="Collapsed" />
        <local:RivalControl Grid.Row="1" x:Name="rivalViewer" Visibility="Collapsed" />
    </Grid>

</UserControl>