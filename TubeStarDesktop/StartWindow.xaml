<Window x:Class="TubeStar.StartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TubeStar" 
        Title="TubeStar"
        MinHeight="560" MinWidth="900"
        Height="768" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextHintingMode="Fixed"
        SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="HighQuality"
        FontFamily="{StaticResource YtFontFamily}"
        Icon="Resources/TubeStar.ico">
    <Grid>
        <Grid x:Name="LayoutRoot" Background="{StaticResource YtDarkBgBrush}">
        </Grid>
    </Grid>
</Window>
