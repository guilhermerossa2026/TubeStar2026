<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Componentes do visual novo (V1 Studio): cartao, pills, botoes, selo, tabela, abas -->

    <!-- .card -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource YtDarkCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource YtDarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource YtCornerRadius}" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <!-- .pill (Border) + texto (PillTextStyle). A cor vem do BorderBrush; o texto herda via TextElement.Foreground -->
    <Style x:Key="PillStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource YtDarkBorderBrush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource YtTextSecondaryBrush}" />
        <Setter Property="TextElement.FontSize" Value="11" />
        <Setter Property="TextElement.FontWeight" Value="Bold" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="9,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="PillGainStyle" TargetType="Border" BasedOn="{StaticResource PillStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource YtGainBrush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource YtGainBrush}" />
    </Style>
    <Style x:Key="PillLossStyle" TargetType="Border" BasedOn="{StaticResource PillStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource YtLossBrush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource YtLossBrush}" />
    </Style>
    <Style x:Key="PillTwitchStyle" TargetType="Border" BasedOn="{StaticResource PillStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource YtTwitchBrush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource YtTwitchBrush}" />
    </Style>
    <Style x:Key="PillRedStyle" TargetType="Border" BasedOn="{StaticResource PillStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource YtRedBrush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource YtRedBrush}" />
    </Style>
    <Style x:Key="PillSoftStyle" TargetType="Border" BasedOn="{StaticResource PillStyle}">
        <Setter Property="TextElement.Foreground" Value="{StaticResource YtTextPrimaryBrush}" />
    </Style>
    <!-- O estilo global de TextBlock fixa a cor; usar este estilo (sem Foreground) faz o texto herdar a cor da pill/selo -->
    <Style x:Key="InheritTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource YtFontFamily}" />
    </Style>

    <!-- .btn.ghost -->
    <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource YtTextSecondaryBrush}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource YtTextPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- .btn.sm -->
    <Style x:Key="SmallButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="9,3" />
    </Style>

    <!-- .btn.pri.sm -->
    <Style x:Key="SmallPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource YtRedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource YtRedBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource YtOnAccentBrush}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="13,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnBorder" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter x:Name="contentPresenter" RecognizesAccessKey="True" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource YtRedHoverBrush}" />
                        </Trigger>
                        <!-- Desativado: cinza-escuro (#2A2A2A) com texto cinza (~#6B6B6B), não vermelho apagado -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="BtnBorder" Property="Background" Value="#2A2A2A" />
                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#2A2A2A" />
                            <Setter TargetName="contentPresenter" Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .thumb em (selo da miniatura) -->
    <Style x:Key="ThumbBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="#CC000000" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="Margin" Value="6" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="TextElement.FontSize" Value="11" />
    </Style>

    <!-- .tbl th -->
    <Style x:Key="TableHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource YtFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource YtTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="TableHeaderRowStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource YtDarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <!-- .tbl tr (com hover) -->
    <Style x:Key="TableRowStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource YtDarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="10,7" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource YtDarkCardHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- .tbl .me (linha do jogador) -->
    <Style x:Key="TableRowMeStyle" TargetType="Border" BasedOn="{StaticResource TableRowStyle}">
        <Setter Property="Background" Value="#2EFF0000" />
        <Setter Property="BorderBrush" Value="{StaticResource YtRedBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,1" />
        <Setter Property="TextElement.FontWeight" Value="Bold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#40FF0000" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- .tab / .tab.on / .tab.soon -->
    <Style x:Key="TabBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="BorderThickness" Value="0,0,0,3" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style x:Key="TabActiveBorderStyle" TargetType="Border" BasedOn="{StaticResource TabBorderStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource YtRedBrush}" />
    </Style>
    <Style x:Key="TabTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource YtFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource YtTextSecondaryBrush}" />
    </Style>

    <!-- Titulos de pagina (h2 + .lead) -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource YtFontFamily}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource YtTextPrimaryBrush}" />
    </Style>
    <Style x:Key="PageLeadStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource YtFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,4,0,14" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource YtTextSecondaryBrush}" />
    </Style>

    <!-- Texto cinza pequeno (.muted .xs) -->
    <Style x:Key="MutedTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource YtFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource YtTextSecondaryBrush}" />
    </Style>
    <!-- .chip / .chip.on (filtros e abas em pilula) -->
    <Style x:Key="ChipButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource YtDarkSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource YtDarkBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource YtTextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource YtFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource YtDarkCardHoverBrush}" />
                <Setter Property="Foreground" Value="{StaticResource YtTextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ChipActiveButtonStyle" TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
        <Setter Property="Background" Value="{StaticResource YtRedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource YtRedBrush}" />
        <!-- Sem borda (+1px de padding): evita o halo escuro nos cantos arredondados -->
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="13,7" />
        <Setter Property="Foreground" Value="{StaticResource YtOnAccentBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource YtRedHoverBrush}" />
                <Setter Property="Foreground" Value="{StaticResource YtOnAccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- .sg / .sg.on (alternador discreto: periodos, abas dentro de um cartao). Conteudo: TextBlock com InheritTextStyle -->
    <Style x:Key="SegButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource YtTextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource YtFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource YtDarkCardHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource YtTextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource YtDisabledTextBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SegButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource SegButtonStyle}">
        <Setter Property="Background" Value="{StaticResource YtDarkCardHoverBrush}" />
        <Setter Property="Foreground" Value="{StaticResource YtTextPrimaryBrush}" />
    </Style>

    <!-- .kpi (rotulo pequeno + valor grande) -->
    <Style x:Key="KpiLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource YtFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,10,0,4" />
        <Setter Property="Foreground" Value="{StaticResource YtTextSecondaryBrush}" />
    </Style>
    <Style x:Key="KpiValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource YtFontFamily}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource YtTextPrimaryBrush}" />
    </Style>

<!-- Cartao de opcao clicavel (janelas: Adicionar tarefa, Novo jogo, Estudar) -->
    <Style x:Key="OptionCardButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource YtDarkSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource YtDarkBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource YtTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource YtFontFamily}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource YtDarkCardHoverBrush}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource YtRedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>