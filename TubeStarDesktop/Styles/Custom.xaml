<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
                    xmlns:local="clr-namespace:TubeStar">

    <!-- Cores Oficiais do YouTube Dark Mode 2026 -->
    <Color x:Key="YtDarkBgColor">#0F0F0F</Color>
    <Color x:Key="YtDarkSurfaceColor">#141414</Color>
    <Color x:Key="YtDarkCardColor">#1F1F1F</Color>
    <Color x:Key="YtDarkCardHoverColor">#262626</Color>
    <Color x:Key="YtDarkBorderColor">#2D2D2D</Color>
    <Color x:Key="YtRedColor">#E53935</Color>
    <Color x:Key="YtRedHoverColor">#EF5350</Color>
    <Color x:Key="YtTextPrimaryColor">#F1F1F1</Color>
    <Color x:Key="YtTextSecondaryColor">#AAAAAA</Color>
    <Color x:Key="YtGainColor">#3EA66B</Color>
    <Color x:Key="YtLossColor">#E5534B</Color>
    <Color x:Key="YtTwitchColor">#9B7BD6</Color>
    <Color x:Key="YtOnAccentColor">#FFFFFF</Color>

    <SolidColorBrush x:Key="YtDarkBgBrush" Color="{StaticResource YtDarkBgColor}" />
    <SolidColorBrush x:Key="YtDarkSurfaceBrush" Color="{StaticResource YtDarkSurfaceColor}" />
    <SolidColorBrush x:Key="YtDarkCardBrush" Color="{StaticResource YtDarkCardColor}" />
    <SolidColorBrush x:Key="YtDarkCardHoverBrush" Color="{StaticResource YtDarkCardHoverColor}" />
    <SolidColorBrush x:Key="YtDarkBorderBrush" Color="{StaticResource YtDarkBorderColor}" />
    <SolidColorBrush x:Key="YtRedBrush" Color="{StaticResource YtRedColor}" />
    <SolidColorBrush x:Key="YtRedHoverBrush" Color="{StaticResource YtRedHoverColor}" />
    <SolidColorBrush x:Key="YtTextPrimaryBrush" Color="{StaticResource YtTextPrimaryColor}" />
    <SolidColorBrush x:Key="YtTextSecondaryBrush" Color="{StaticResource YtTextSecondaryColor}" />
    <SolidColorBrush x:Key="YtGainBrush" Color="{StaticResource YtGainColor}" />
    <SolidColorBrush x:Key="YtLossBrush" Color="{StaticResource YtLossColor}" />
    <SolidColorBrush x:Key="YtTwitchBrush" Color="{StaticResource YtTwitchColor}" />
    <SolidColorBrush x:Key="YtOnAccentBrush" Color="{StaticResource YtOnAccentColor}" />
    <!-- Estrela de favorito (Mercado financeiro) -->
    <SolidColorBrush x:Key="YtFavoriteBrush" Color="#F5C518" />
    <SolidColorBrush x:Key="YtDisabledBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="YtDisabledTextBrush" Color="#6B6B6B" />

    <SolidColorBrush x:Key="YtButtonHoverBrush" Color="#555555" />
    <SolidColorBrush x:Key="YtButtonPressedBrush" Color="#404040" />
    <SolidColorBrush x:Key="YtDropHighlightBrush" Color="{StaticResource YtRedColor}" Opacity="0.35" />

    <CornerRadius x:Key="YtCornerRadius">10</CornerRadius>
    <FontFamily x:Key="YtFontFamily">pack://application:,,,/Fonts/#Inter, Segoe UI</FontFamily>

    <!-- Estilo Global de TextBlock -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource YtTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource YtFontFamily}" />
    </Style>

    <!-- ToolTips Escuras -->
    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource YtFontFamily}"/>
        <Setter Property="Background" Value="{StaticResource YtDarkCardBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource YtTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource YtDarkBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Estilo Global de TextBox (Caixa de Texto Dark) -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource YtFontFamily}"/>
        <Setter Property="Background" Value="{StaticResource YtDarkSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource YtTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource YtDarkBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="CaretBrush" Value="{StaticResource YtTextPrimaryBrush}"/>
    </Style>

    <!-- Estilo Global de ComboBox (Menu de Seleção Dark) -->
    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource YtFontFamily}"/>
        <Setter Property="Background" Value="{StaticResource YtDarkSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource YtTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource YtDarkBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <!-- Modelo escuro (o padrao do Windows ignora o Background e fica claro) -->
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bd" Background="{StaticResource YtDarkSurfaceBrush}" BorderBrush="{StaticResource YtDarkBorderBrush}" BorderThickness="1" CornerRadius="6" Cursor="Hand">
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Data="M0,0 L5,5 L10,0" Stroke="{StaticResource YtTextSecondaryBrush}" StrokeThickness="1.6" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource YtButtonHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Margin="{TemplateBinding Padding}" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" VerticalAlignment="Center" HorizontalAlignment="Left" TextElement.Foreground="{StaticResource YtTextPrimaryBrush}" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,4,0,0" Background="{StaticResource YtDarkCardBrush}" BorderBrush="{StaticResource YtDarkBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource YtTextPrimaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="8,6">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource YtDarkCardHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource YtRedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ScrollBar escura e fina (sem setas) -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{StaticResource YtDarkSurfaceBrush}"/>
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{StaticResource YtDarkSurfaceBrush}" CornerRadius="4">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="th" Background="#3A3A3A" CornerRadius="4"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="th" Property="Background" Value="#4A4A4A"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="th" Property="Background" Value="#4A4A4A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="MinHeight" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{StaticResource YtDarkSurfaceBrush}" CornerRadius="4">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="th" Background="#3A3A3A" CornerRadius="4"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="th" Property="Background" Value="#4A4A4A"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Estilo Global de ListBox(Listas Dark sem fundo branco) -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource YtDarkSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource YtTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource YtDarkBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Estilo Global de ListBoxItem -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource YtTextPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="6,4"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource YtDarkCardHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource YtRedBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource YtOnAccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Estilo dos Dialogos Popups do Jogo (ChildWindow) -->
    <Style TargetType="xctk:ChildWindow">
        <Setter Property="BorderBrush" Value="{StaticResource YtDarkBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaptionForeground" Value="{StaticResource YtOnAccentBrush}"/>
        <Setter Property="CloseButtonVisibility" Value="Collapsed"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="xctk:ChildWindow">
                    <!-- Fundo escurecido (modal) + janela centralizada -->
                    <Grid Background="#B3000000">
                        <Border x:Name="WindowFrame"
                                Margin="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{StaticResource YtDarkCardBrush}"
                                BorderBrush="{StaticResource YtDarkBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6" Color="Black" />
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="{StaticResource YtDarkSurfaceBrush}" CornerRadius="10,10,0,0" BorderBrush="{StaticResource YtDarkBorderBrush}" BorderThickness="0,0,0,1" Padding="18,12">
                                    <TextBlock Text="{TemplateBinding Caption}"
                                               Foreground="{StaticResource YtTextPrimaryBrush}"
                                               FontWeight="Bold"
                                               FontSize="16"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <ScrollViewer Grid.Row="1" Margin="0,0,0,10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <ContentPresenter Margin="16,14,16,4" Content="{TemplateBinding Content}" />
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DialogLabelStyle" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="5,4,5,2"/>
        <Setter Property="Foreground" Value="{StaticResource YtTextSecondaryBrush}"/>
    </Style>

    <Style x:Key="ClickStyle" TargetType="FrameworkElement">
        <Style.Resources>
            <Storyboard x:Key="OnClickAnimation">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" Storyboard.TargetName="{x:Null}">
                    <EasingDoubleKeyFrame KeyTime="0" Value="0.97"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="1"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" Storyboard.TargetName="{x:Null}">
                    <EasingDoubleKeyFrame KeyTime="0" Value="0.97"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="1"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </Style.Resources>

        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TriggerClickStyle" TargetType="FrameworkElement" BasedOn="{StaticResource ClickStyle}">
        <Style.Triggers>
            <EventTrigger RoutedEvent="ButtonBase.PreviewMouseLeftButtonDown">
                <BeginStoryboard x:Name="OnClick1_BeginStoryboard" Storyboard="{StaticResource OnClickAnimation}"/>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="local:StoreItemBlock" BasedOn="{StaticResource ClickStyle}" />
    <Style TargetType="local:VideoBlockGrid" BasedOn="{StaticResource ClickStyle}" />

    <!-- Botões Globais: Cards Dark com Hover Sutil e Texto Alto Contraste -->
    <Style TargetType="Button" BasedOn="{StaticResource TriggerClickStyle}">
        <Setter Property="FontFamily" Value="{StaticResource YtFontFamily}"/>
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource YtTextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource YtDarkCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource YtDarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnBorder"
                            CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter x:Name="contentPresenter"
                                          RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover cinza elegante em vez de branco lavado -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource YtDarkCardHoverBrush}" />
                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{StaticResource YtButtonHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource YtButtonPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="BtnBorder" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="NonAnimatedButtonStyle" BasedOn="{StaticResource {x:Type Button}}" />

    <!-- Abas Superiores -->
    <Style TargetType="ToggleButton" BasedOn="{StaticResource TriggerClickStyle}">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource YtTextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource YtDarkSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource YtDarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="TogBorder"
                            CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter x:Name="contentPresenter"
                                          RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TogBorder" Property="Background" Value="{StaticResource YtDarkCardHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="TogBorder" Property="Background" Value="{StaticResource YtRedBrush}" />
                            <Setter TargetName="TogBorder" Property="BorderBrush" Value="{StaticResource YtRedBrush}" />
                            <Setter TargetName="TogBorder" Property="BorderThickness" Value="0" />
                            <Setter TargetName="contentPresenter" Property="Margin" Value="15,7" />
                            <Setter Property="Foreground" Value="{StaticResource YtOnAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="TogBorder" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
