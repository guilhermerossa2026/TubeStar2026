<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Ícones vetoriais estilo "linha" (caixa 24x24). Desenhar com o IconPath/IconViewbox abaixo. -->
    <Geometry x:Key="IconHome">M3,10.5 L12,3 L21,10.5 M5,9 V21 H19 V9 M10,21 V14 H14 V21</Geometry>
    <Geometry x:Key="IconCalendar">M4,6 H20 V21 H4 Z M4,10 H20 M8,3 V7 M16,3 V7</Geometry>
    <Geometry x:Key="IconFilm">M3,4 H21 V20 H3 Z M7,4 V20 M17,4 V20 M3,9 H7 M3,15 H7 M17,9 H21 M17,15 H21</Geometry>
    <Geometry x:Key="IconPlus">M12,3 A9,9 0 1 1 11.99,3 Z M12,8 V16 M8,12 H16</Geometry>
    <Geometry x:Key="IconSend">M12,16 V4 M7,9 L12,4 L17,9 M4,15 V20 H20 V15</Geometry>
    <Geometry x:Key="IconBag">M5,8 H19 L18,21 H6 Z M9,8 V6 A3,3 0 0 1 15,6 V8</Geometry>
    <Geometry x:Key="IconTrophy">M8,4 H16 V10 A4,4 0 0 1 8,10 Z M8,6 H4 V8 A3,3 0 0 0 8,11 M16,6 H20 V8 A3,3 0 0 1 16,11 M12,14 V18 M8,21 H16 M9,18 H15</Geometry>
    <Geometry x:Key="IconCap">M2,9 L12,4 L22,9 L12,14 Z M6,11 V16 C6,18.5 18,18.5 18,16 V11 M22,9 V15</Geometry>
    <Geometry x:Key="IconTeam">M9,4 A3.5,3.5 0 1 1 8.99,4 Z M2,20 C2,14.5 16,14.5 16,20 M15.5,4.2 A3.5,3.5 0 0 1 15.5,10.8 M18,15 C20.5,15.6 22,17.5 22,20</Geometry>
    <Geometry x:Key="IconPlay">M8,5 L19,12 L8,19 Z</Geometry>
    <Geometry x:Key="IconSave">M4,3 H16 L20,7 V21 H4 Z M8,3 V8 H15 V3 M7,21 V14 H17 V21</Geometry>
    <Geometry x:Key="IconHelp">M12,3 A9,9 0 1 1 11.99,3 Z M9.5,9.5 A2.5,2.5 0 1 1 13,11.8 C12.3,12.2 12,12.7 12,13.5 V14 M12,17 V17.6</Geometry>
    <Geometry x:Key="IconExit">M10,4 H5 V20 H10 M14,8 L18,12 L14,16 M18,12 H9</Geometry>
    <Geometry x:Key="IconComment">M4,5 H20 V16 H10 L6,20 V16 H4 Z</Geometry>

    <!-- Item do menu lateral: Tag = geometria do ícone, Content = texto -->
    <Style x:Key="NavItemStyle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource YtTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource YtFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="11,9">
                        <DockPanel>
                            <Viewbox Width="20" Height="20" DockPanel.Dock="Left" Margin="0,0,12,0">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="icon" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                            <ContentPresenter VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource YtDarkCardHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource YtDarkCardBrush}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource YtDarkBorderBrush}" />
                            <Setter TargetName="icon" Property="Stroke" Value="{DynamicResource YtRedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botão-ícone pequeno do cabeçalho (salvar, ajuda, sair): Tag = geometria -->
    <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource YtTextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="8" Width="36" Height="36">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource YtDarkCardHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource YtTextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botão vermelho principal (.btn.pri) -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource YtOnAccentBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource YtFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{DynamicResource YtRedBrush}" CornerRadius="10" Padding="16,9">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource YtRedHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
