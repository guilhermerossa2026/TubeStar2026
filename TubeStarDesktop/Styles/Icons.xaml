    <!-- Item do menu lateral: Tag = geometria do ícone, Content = texto -->
    <Style x:Key="NavItemStyle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource YtTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource YtFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="11,9">
                        <DockPanel>
                            <Viewbox Width="20" Height="20" DockPanel.Dock="Left" Margin="0,0,12,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                
                                    <Canvas Width="256" Height="256"><Path x:Name="icon" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Fill="{TemplateBinding Foreground}" Stretch="None" /></Canvas>
                                
                            </Viewbox>
                            <ContentPresenter VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource YtDarkCardHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource YtDarkCardBrush}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource YtDarkBorderBrush}" />
                            <Setter TargetName="icon" Property="Fill" Value="{DynamicResource YtRedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botão-ícone pequeno do cabeçalho (salvar, ajuda, sair): Tag = geometria -->
    <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource YtTextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="8" Width="36" Height="36">
                        <Viewbox Width="20" Height="20" SnapsToDevicePixels="True" UseLayoutRounding="True">
                            
                                <Canvas Width="256" Height="256"><Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Fill="{TemplateBinding Foreground}" Stretch="None" /></Canvas>
                            
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource YtDarkCardHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource YtTextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botão vermelho principal (.btn.pri) -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource YtOnAccentBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource YtFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{DynamicResource YtRedBrush}" CornerRadius="10" Padding="16,9">
                        <ContentPresenter x:Name="cp" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource YtRedHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <!-- Desativado: cinza-escuro (#2A2A2A) com texto cinza (~#6B6B6B), não vermelho apagado -->
                            <Setter TargetName="bd" Property="Background" Value="#2A2A2A" />
                            <Setter TargetName="cp" Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

