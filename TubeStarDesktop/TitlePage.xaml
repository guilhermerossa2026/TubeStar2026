<UserControl x:Class="TubeStar.TitlePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:TubeStar">

    <Grid x:Name="LayoutRoot" Background="{StaticResource YtDarkBgBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30">
                <!-- Logo: retangulo vermelho com play + nome -->
                <Border Width="92" Height="64" CornerRadius="18" Background="{StaticResource YtRedBrush}" HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconPlay}" Fill="{StaticResource YtOnAccentBrush}" Stroke="{StaticResource YtOnAccentBrush}" StrokeThickness="2" StrokeLineJoin="Round" Width="34" Height="34" Stretch="Uniform" Margin="4,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="TubeStar" FontSize="62" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                <TextBlock x:Name="txtTagline" Text="Your path from zero to YouTube star" FontSize="15" Foreground="{StaticResource YtTextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" />

                <!-- Menu -->
                <StackPanel Width="300" Margin="0,26,0,0">
                    <Button x:Name="btnNewGame" Content="New game" FontSize="16" Height="46" Margin="0,0,0,12" Style="{StaticResource PrimaryButtonStyle}" Click="NewGame_Click" />
                    <Button x:Name="btnContinue" Content="Continue game" FontSize="16" Height="46" Margin="0,0,0,12" Click="ContinueGame_Click" />
                    <Button x:Name="btnTutorial" Content="Tutorial" FontSize="15" Height="42" Margin="0,0,0,12" Click="Tutorial_Click" />
                    <Button x:Name="btnCredits" Content="Credits" FontSize="15" Height="42" Margin="0,0,0,12" Click="Credits_Click" />
                    <Button x:Name="btnExit" Content="Exit" FontSize="15" Height="42" Style="{StaticResource GhostButtonStyle}" Click="Exit_Click" />
                </StackPanel>

                <!-- Idiomas -->
                <WrapPanel HorizontalAlignment="Center" MaxWidth="340" Margin="0,28,0,0">
                    <Image x:Name="imgUK" Height="26" Margin="3" Cursor="Hand" Source="Resources/Languages/English.png" MouseLeftButtonDown="imgUK_MouseLeftButtonDown"/>
                    <Image x:Name="imgBrazil" Height="26" Margin="3" Cursor="Hand" Source="Resources/Languages/Brazil.png" MouseLeftButtonDown="imgBrazil_MouseLeftButtonDown"/>
                    <Image x:Name="imgPortugal" Height="26" Margin="3" Cursor="Hand" Source="Resources/Languages/Portugal.png" MouseLeftButtonDown="imgPortugal_MouseLeftButtonDown"/>
                    <Image x:Name="imgSpain" Height="26" Margin="3" Cursor="Hand" Source="Resources/Languages/Spanish.png" MouseLeftButtonDown="imgSpain_MouseLeftButtonDown"/>
                    <Image x:Name="imgFrance" Height="26" Margin="3" Cursor="Hand" Source="Resources/Languages/French.png" MouseLeftButtonDown="imgFrance_MouseLeftButtonDown"/>
                    <Image x:Name="imgNetherlands" Height="26" Margin="3" Cursor="Hand" Source="Resources/Languages/Dutch.png" MouseLeftButtonDown="imgNetherlands_MouseLeftButtonDown"/>
                    <Image x:Name="imgGermany" Height="26" Margin="3" Cursor="Hand" Source="Resources/Languages/German.png" MouseLeftButtonDown="imgGermany_MouseLeftButtonDown"/>
                    <Image x:Name="imgItaly" Height="26" Margin="3" Cursor="Hand" Source="Resources/Languages/Italian.png" MouseLeftButtonDown="imgItaly_MouseLeftButtonDown"/>
                    <Image x:Name="imgCzech" Height="26" Margin="3" Cursor="Hand" Source="Resources/Languages/Czech.png" MouseLeftButtonDown="imgCzech_MouseLeftButtonDown"/>
                    <Image x:Name="imgSweden" Height="26" Margin="3" Cursor="Hand" Source="Resources/Languages/Swedish.png" MouseLeftButtonDown="imgSweden_MouseLeftButtonDown"/>
                    <Image x:Name="imgPoland" Height="26" Margin="3" Cursor="Hand" Source="Resources/Languages/Polish.png" MouseLeftButtonDown="imgPoland_MouseLeftButtonDown"/>
                    <Image x:Name="imgHungary" Height="26" Margin="3" Cursor="Hand" Source="Resources/Languages/Hungarian.png" MouseLeftButtonDown="imgHungary_MouseLeftButtonDown"/>
                    <Image x:Name="imgAlbania" Height="26" Margin="3" Cursor="Hand" Source="Resources/Languages/Albanian.png" MouseLeftButtonDown="imgAlbania_MouseLeftButtonDown"/>
                    <Image x:Name="imgRomania" Height="26" Margin="3" Cursor="Hand" Source="Resources/Languages/Romanian.png" MouseLeftButtonDown="imgRomania_MouseLeftButtonDown"/>
                    <Image x:Name="imgTurkey" Height="26" Margin="3" Cursor="Hand" Source="Resources/Languages/Turkish.png" MouseLeftButtonDown="imgTurkey_MouseLeftButtonDown"/>
                    <Image x:Name="imgRussia" Height="26" Margin="3" Cursor="Hand" Source="Resources/Languages/Russian.png" MouseLeftButtonDown="imgRussia_MouseLeftButtonDown"/>
                    <Image x:Name="imgGeorgia" Height="26" Margin="3" Cursor="Hand" Source="Resources/Languages/Georgia.png" MouseLeftButtonDown="imgGeorgia_MouseLeftButtonDown"/>
                    <Image x:Name="imgChina" Height="26" Margin="3" Cursor="Hand" Source="Resources/Languages/Chinese.png" MouseLeftButtonDown="imgChina_MouseLeftButtonDown"/>
                    <Image x:Name="imgIndonesia" Height="26" Margin="3" Cursor="Hand" Source="Resources/Languages/Indonesian.png" MouseLeftButtonDown="imgIndonesia_MouseLeftButtonDown"/>
                    <Image x:Name="imgThailand" Height="26" Margin="3" Cursor="Hand" Source="Resources/Languages/Thai.png" MouseLeftButtonDown="imgThailand_MouseLeftButtonDown"/>
                </WrapPanel>
                <TextBlock x:Name="TranslatedBy" HorizontalAlignment="Center" Text="" FontSize="11" Foreground="{StaticResource YtTextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="500" TextAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
