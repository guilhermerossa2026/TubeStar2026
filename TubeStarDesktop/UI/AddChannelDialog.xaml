<xctk:ChildWindow x:Class="TubeStar.AddChannelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:TubeStar"
        Caption="Add channel">

    <StackPanel Width="440">
        <TextBlock x:Name="lblName" Text="Name:" Style="{StaticResource DialogLabelStyle}" Margin="0,0,0,6" />
        <TextBox x:Name="txtName" FontSize="15" Margin="0,0,0,14" />

        <TextBlock x:Name="lblStrategy" Text="Advertising strategy:" Style="{StaticResource DialogLabelStyle}" Margin="0,0,0,6" />
        <ComboBox x:Name="cmbAdvertising" FontSize="15" Margin="0,0,0,18" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnCancel" Content="Cancel" IsCancel="True" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button x:Name="btnOk" Content="OK" IsDefault="True" MinWidth="100" Style="{StaticResource PrimaryButtonStyle}" Click="OKButton_Click"/>
        </StackPanel>
    </StackPanel>

</xctk:ChildWindow>
