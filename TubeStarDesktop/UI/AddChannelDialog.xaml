<xctk:ChildWindow x:Class="TubeStar.AddChannelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:TubeStar"
        Caption="Add channel">

    <StackPanel Width="520">
        <TextBlock x:Name="lblName" Text="Name:" Style="{StaticResource DialogLabelStyle}" Margin="0,0,0,6" />
        <TextBox x:Name="txtName" FontSize="15" Margin="0,0,0,14" />

        <TextBlock x:Name="lblNiche" Text="Niche:" Style="{StaticResource DialogLabelStyle}" Margin="0,0,0,6" />
        <WrapPanel x:Name="nicheChips" Margin="0,0,0,2" />
        <TextBlock x:Name="txtNicheInfo" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,14" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock x:Name="lblStrategy" Text="Ads in videos:" Style="{StaticResource DialogLabelStyle}" />
            <TextBlock x:Name="lblStrategyHelp" Text="?" FontWeight="Bold" Margin="8,0,0,0" Cursor="Help"
                       Foreground="{StaticResource YtRedBrush}" VerticalAlignment="Center" />
        </StackPanel>
        <ComboBox x:Name="cmbAdvertising" FontSize="15" Margin="0,0,0,18" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnCancel" Content="Cancel" IsCancel="True" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button x:Name="btnOk" Content="OK" IsDefault="True" MinWidth="100" Style="{StaticResource PrimaryButtonStyle}" Click="OKButton_Click"/>
        </StackPanel>
    </StackPanel>

</xctk:ChildWindow>
