<xctk:ChildWindow x:Class="TubeStar.CalendarDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Caption="Calendar"
        WindowStartupLocation="Center">

    <StackPanel Width="720">
        <TextBlock x:Name="txtDate" FontSize="16" FontWeight="Bold" />
        <TextBlock x:Name="txtAdSeason" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0" Visibility="Collapsed" />

        <!-- Dias da semana atual -->
        <UniformGrid x:Name="weekDays" Rows="1" Columns="7" Margin="-4,10,-4,0" />

        <!-- Semana atual até agora -->
        <TextBlock x:Name="txtThisWeek" Text="This week so far" FontWeight="Bold" FontSize="14" Margin="0,16,0,6" />
        <Border Style="{StaticResource CardBorderStyle}">
            <Grid>
                <UniformGrid x:Name="weekKpis" Columns="7" />
                <TextBlock x:Name="txtWeekEmpty" Style="{StaticResource MutedTextStyle}" Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- Histórico -->
        <TextBlock x:Name="txtHistory" Text="Past summaries" FontWeight="Bold" FontSize="14" Margin="0,16,0,6" />
        <Border Style="{StaticResource CardBorderStyle}" Padding="0">
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel x:Name="historyRows" />
                    <TextBlock x:Name="txtNoHistory" Style="{StaticResource MutedTextStyle}" Margin="10,10" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="btnOk" IsDefault="True" IsCancel="True" MinWidth="100" Content="OK" Style="{StaticResource PrimaryButtonStyle}" Click="OKButton_Click" />
        </StackPanel>
    </StackPanel>
</xctk:ChildWindow>
