<xctk:ChildWindow x:Class="TubeStar.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Caption="Message"
        WindowStartupLocation="Center">

    <Grid Width="560">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Imagem com cantos arredondados (Clip evita vazar do canto) -->
        <Image x:Name="imgMsg" Width="120" Height="120" Stretch="UniformToFill" VerticalAlignment="Top">
            <Image.Clip>
                <RectangleGeometry Rect="0,0,120,120" RadiusX="10" RadiusY="10" />
            </Image.Clip>
        </Image>

        <TextBlock x:Name="messageBoxTextBlock" Grid.Column="1" Text="Message" VerticalAlignment="Center" Margin="18,0,0,0" FontSize="15" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="btnCancel" Content="Cancel" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button x:Name="btnOk" Content="OK" MinWidth="100" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="OKButton_Click"/>
        </StackPanel>
    </Grid>

</xctk:ChildWindow>
