<UserControl x:Class="TubeStar.DailyPlanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TubeStar" >

    <Grid x:Name="LayoutRoot" Background="{StaticResource YtDarkBgBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,16">
            <StackPanel MaxWidth="980" HorizontalAlignment="Stretch">
                <TextBlock x:Name="txtTitle" Text="Schedule" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="txtLead" Text="Distribute the hours of the day." Style="{StaticResource PageLeadStyle}" />

                <!-- Horas do dia -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="txtDayHours" Text="Hours of the day (15h)" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />
                        <UniformGrid x:Name="hoursBar" Rows="1" Columns="15" Height="34" />
                        <TextBlock x:Name="txtHoursUsed" Text="0 of 15 hours used" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Cartões de tarefa -->
                <UniformGrid x:Name="tasksPanel" Columns="2" Margin="-6,0,-6,0" />

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="btnAddTask" Style="{StaticResource PrimaryButtonStyle}" Click="AddTask_Click">
                        <TextBlock x:Name="txtAddTask" Text="+ Add Task" Style="{StaticResource InheritTextStyle}" />
                    </Button>
                    <TextBlock x:Name="txtAddTaskHint" Text="Work, shoot, edit, study" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
