<xctk:ChildWindow x:Class="TubeStar.EditVideoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Caption="Edit video"
        WindowStartupLocation="Center" >
    
    <StackPanel Width="440">
        <TextBlock x:Name="lblVideo" Text="Video: " Style="{StaticResource DialogLabelStyle}" Margin="0,0,0,6" />
        <ComboBox x:Name="cmbVideo" FontSize="15" Margin="0,0,0,14" />

        <TextBlock x:Name="lblHoursSelect" Text="Hours: " Style="{StaticResource DialogLabelStyle}" Margin="0,0,0,6" />
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Slider x:Name="sldrHours" Minimum="4" Maximum="8" TickFrequency="1" Value="4" VerticalAlignment="Center" Height="12" SmallChange="1" IsSnapToTickEnabled="True" ValueChanged="sldrHours_ValueChanged" Style="{StaticResource FlatSlider}" />
            <TextBlock x:Name="lblHours" Grid.Column="1" FontSize="14" FontWeight="SemiBold" Text="4 hours" VerticalAlignment="Center" Margin="14,0,0,0" />
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnCancel" Content="Cancel" IsCancel="True" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button x:Name="btnOk" Content="OK" MinWidth="100" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="OKButton_Click"/>
        </StackPanel>
    </StackPanel>
</xctk:ChildWindow>
