<xctk:ChildWindow x:Class="TubeStar.EditVideoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Caption="Edit video"
        WindowStartupLocation="Center" >
    
    <StackPanel Width="440">
        <TextBlock x:Name="lblVideo" Text="Video: " Style="{StaticResource DialogLabelStyle}" Margin="0,0,0,6" />
        <ComboBox x:Name="cmbVideo" FontSize="15" Margin="0,0,0,14" />

        <TextBlock x:Name="lblHoursSelect" Text="Hours: " Style="{StaticResource DialogLabelStyle}" Margin="0,0,0,6" />
        <TextBlock x:Name="lblHours" FontSize="14" FontWeight="SemiBold" Text="4 hours" Margin="0,0,0,4" />
        <TextBlock x:Name="lblHoursHint" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,18" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnCancel" Content="Cancel" IsCancel="True" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button x:Name="btnOk" Content="OK" MinWidth="100" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="OKButton_Click"/>
        </StackPanel>
    </StackPanel>
</xctk:ChildWindow>
