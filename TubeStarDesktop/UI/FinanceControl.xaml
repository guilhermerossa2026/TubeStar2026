<UserControl x:Class="TubeStar.FinanceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TubeStar" >

    <Grid Background="{StaticResource YtDarkBgBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,24,20">
            <StackPanel MaxWidth="1400" HorizontalAlignment="Stretch">
                <TextBlock x:Name="txtTitle" Text="Finances" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="txtLead" Text="Your money, your results and where it goes." Style="{StaticResource PageLeadStyle}" />

                <!-- Abas: Visão geral e Colecionáveis (em breve) -->
                <Border BorderBrush="{StaticResource YtDarkBorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource TabActiveBorderStyle}">
                            <TextBlock x:Name="txtTabOverview" Text="Overview" Style="{StaticResource TabTextStyle}" Foreground="{StaticResource YtTextPrimaryBrush}" />
                        </Border>
                        <Border Style="{StaticResource TabBorderStyle}" Opacity="0.6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="txtTabCollectibles" Text="Collectibles" Style="{StaticResource TabTextStyle}" />
                                <Border Style="{StaticResource PillStyle}" Margin="8,0,0,0"><TextBlock x:Name="txtSoon3" Text="Soon" FontSize="10" /></Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 4 números -->
                <UniformGrid Columns="4" Margin="0,0,0,14">
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock x:Name="txtCashLabel" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock x:Name="txtCash" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                            <TextBlock x:Name="txtCashNote" Style="{StaticResource MutedTextStyle}" Margin="0,2,0,0" Text=" " />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock x:Name="txtInvestedLabel" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock x:Name="txtInvested" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                            <TextBlock x:Name="txtInvestedNote" Style="{StaticResource MutedTextStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock x:Name="txtWeekLabel" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock x:Name="txtWeek" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                            <TextBlock x:Name="txtWeekNote" Style="{StaticResource MutedTextStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock x:Name="txtYearLabel" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock x:Name="txtYear" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                            <TextBlock x:Name="txtYearNote" Style="{StaticResource MutedTextStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Patrimônio -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="txtChartTitle" FontWeight="Bold" FontSize="14" />
                        <Grid Height="170" Margin="0,10,0,0">
                            <Canvas x:Name="chartCanvas" ClipToBounds="True" SizeChanged="ChartCanvas_SizeChanged" />
                            <TextBlock x:Name="txtChartEmpty" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                        </Grid>
                        <TextBlock x:Name="txtCompTitle" FontWeight="Bold" FontSize="14" Margin="0,14,0,8" />
                        <Border CornerRadius="4" ClipToBounds="True" Height="14" Background="{StaticResource YtDarkSurfaceBrush}">
                            <Grid x:Name="compBar" />
                        </Border>
                        <WrapPanel x:Name="compLegend" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Entradas e saídas da semana -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,7,0">
                        <StackPanel>
                            <TextBlock x:Name="txtIncomeTitle" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
                            <StackPanel x:Name="incomePanel" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="7,0,0,0">
                        <StackPanel>
                            <TextBlock x:Name="txtSpendingTitle" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
                            <StackPanel x:Name="spendingPanel" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Extrato -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="txtStatementTitle" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
                        <TextBlock x:Name="txtNoWeeks" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
                        <StackPanel x:Name="statementPanel" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
