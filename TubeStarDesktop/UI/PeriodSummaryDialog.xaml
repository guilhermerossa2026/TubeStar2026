<xctk:ChildWindow x:Class="TubeStar.PeriodSummaryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Caption="Summary"
        WindowStartupLocation="Center">

    <StackPanel Width="760">
        <!-- Totais do período -->
        <Border Style="{StaticResource CardBorderStyle}">
            <UniformGrid x:Name="kpiGrid" Columns="7" />
        </Border>

        <!-- Por canal -->
        <TextBlock x:Name="txtByChannel" Text="By channel" FontWeight="Bold" FontSize="14" Margin="0,14,0,6" />
        <Border Style="{StaticResource CardBorderStyle}" Padding="0">
            <StackPanel>
                <Border Style="{StaticResource TableHeaderRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="hdrChannel" Grid.Column="0" Text="Channel" Style="{StaticResource TableHeaderTextStyle}" />
                        <TextBlock x:Name="hdrViews" Grid.Column="1" Text="Views" Style="{StaticResource TableHeaderTextStyle}" HorizontalAlignment="Right" />
                        <TextBlock x:Name="hdrSubscribers" Grid.Column="2" Text="New subscribers" Style="{StaticResource TableHeaderTextStyle}" HorizontalAlignment="Right" />
                        <TextBlock x:Name="hdrBestVideo" Grid.Column="3" Text="Best video" Style="{StaticResource TableHeaderTextStyle}" Margin="16,0,0,0" />
                    </Grid>
                </Border>
                <StackPanel x:Name="channelRows" />
                <TextBlock x:Name="txtNoChannels" Text="No channel had activity." Style="{StaticResource MutedTextStyle}" Margin="10,10" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="btnOk" IsDefault="True" IsCancel="True" MinWidth="100" Content="OK" Style="{StaticResource PrimaryButtonStyle}" Click="OKButton_Click" />
        </StackPanel>
    </StackPanel>
</xctk:ChildWindow>
