<UserControl x:Class="TubeStar.RivalControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TubeStar" >

    <Grid x:Name="LayoutRoot" Background="{StaticResource YtDarkBgBrush}">

        <!-- Ranking (S.top) -->
        <ScrollViewer x:Name="rankingView" BorderThickness="0" VerticalScrollBarVisibility="Auto" Padding="24,20,24,20">
            <StackPanel>
                <TextBlock x:Name="txtTitle" Style="{StaticResource PageTitleStyle}" Text="Top TubeStars" />
                <TextBlock x:Name="txtLead" Style="{StaticResource PageLeadStyle}" />

                <!-- .tabs -->
                <Border BorderBrush="{StaticResource YtDarkBorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource TabActiveBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPlay}" Fill="{StaticResource YtRedBrush}" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource TabTextStyle}" Foreground="{StaticResource YtTextPrimaryBrush}" Text="YouTube" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TabBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource TabTextStyle}" Foreground="{StaticResource YtTwitchBrush}" Text="Twitch" />
                                <Border Style="{StaticResource PillTwitchStyle}" Margin="8,0,0,0">
                                    <TextBlock x:Name="txtSoonTwitch" Style="{StaticResource InheritTextStyle}" Text="Soon" />
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TabBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource TabTextStyle}" Foreground="{StaticResource YtTwitchBrush}" Text="Podcast" />
                                <Border Style="{StaticResource PillTwitchStyle}" Margin="8,0,0,0">
                                    <TextBlock x:Name="txtSoonPodcast" Style="{StaticResource InheritTextStyle}" Text="Soon" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- .card > .tbl -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                    <StackPanel>
                        <Border Style="{StaticResource TableHeaderRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource TableHeaderTextStyle}" Text="#" />
                                <TextBlock x:Name="thChannel" Grid.Column="2" Style="{StaticResource TableHeaderTextStyle}" Text="CHANNEL" />
                                <TextBlock x:Name="thSubscribers" Grid.Column="3" Style="{StaticResource TableHeaderTextStyle}" HorizontalAlignment="Right" Text="SUBSCRIBERS" />
                                <TextBlock x:Name="thViews" Grid.Column="4" Style="{StaticResource TableHeaderTextStyle}" HorizontalAlignment="Right" Text="VIEWS" />
                            </Grid>
                        </Border>
                        <StackPanel x:Name="rankingPanel" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Videos do rival escolhido -->
        <Grid x:Name="channelView" Visibility="Collapsed" Margin="24,16,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnBack" Grid.Column="0" Style="{StaticResource GhostButtonStyle}" Content="‹ Back to Top" VerticalAlignment="Center" Click="btnBack_Click" />

                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                    <TextBlock x:Name="channelNameTextBlock" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="channelSummaryTextBlock" Style="{StaticResource MutedTextStyle}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="gridViewer" Grid.Row="1" BorderThickness="0" VerticalScrollBarVisibility="Auto">
                <UniformGrid x:Name="videoPanelGrid" Columns="3" VerticalAlignment="Top" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
