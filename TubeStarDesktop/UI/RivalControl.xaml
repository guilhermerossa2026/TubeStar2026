<UserControl x:Class="TubeStar.RivalControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TubeStar" >

    <Grid x:Name="LayoutRoot" Background="{StaticResource YtDarkBgBrush}">

        <!-- Ranking: destaques da semana + abas + tabela paginada -->
        <ScrollViewer x:Name="rankingView" BorderThickness="0" VerticalScrollBarVisibility="Auto" Padding="24,20,24,20">
            <StackPanel>
                <TextBlock x:Name="txtTitle" Style="{StaticResource PageTitleStyle}" Text="Top TubeStars" />
                <TextBlock x:Name="txtLead" Style="{StaticResource PageLeadStyle}" />

                <!-- .tabs (plataformas) -->
                <Border BorderBrush="{StaticResource YtDarkBorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource TabActiveBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" SnapsToDevicePixels="True" UseLayoutRounding="True"><Canvas Width="256" Height="256"><Path Data="{StaticResource IconPlay}" Fill="{StaticResource YtRedBrush}" Stretch="None" /></Canvas></Viewbox>
                                <TextBlock Style="{StaticResource TabTextStyle}" Foreground="{StaticResource YtTextPrimaryBrush}" Text="YouTube" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TabBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource TabTextStyle}" Foreground="{StaticResource YtTwitchBrush}" Text="Twitch" />
                                <Border Style="{StaticResource PillTwitchStyle}" Margin="8,0,0,0">
                                    <TextBlock x:Name="txtSoonTwitch" Style="{StaticResource InheritTextStyle}" Text="Soon" />
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TabBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource TabTextStyle}" Foreground="{StaticResource YtTwitchBrush}" Text="Podcast" />
                                <Border Style="{StaticResource PillTwitchStyle}" Margin="8,0,0,0">
                                    <TextBlock x:Name="txtSoonPodcast" Style="{StaticResource InheritTextStyle}" Text="Soon" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- destaques da semana -->
                <UniformGrid x:Name="highlights" Columns="3" Margin="-6,0,-6,12" />

                <!-- filtros: Geral / Cresceu na semana + nicho -->
                <Grid Margin="0,0,0,2">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="btnTabAll" Click="btnTabAll_Click" />
                        <Button x:Name="btnTabWeek" Click="btnTabWeek_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button x:Name="btnGoToTop" Style="{StaticResource GhostButtonStyle}" Click="btnGoToTop_Click" />
                        <Button x:Name="btnGoToMe" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Click="btnGoToMe_Click" />
                    </StackPanel>
                </Grid>
                <WrapPanel x:Name="nicheFilter" Margin="0,0,0,8" />

                <!-- .card > .tbl -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                    <StackPanel>
                        <Border Style="{StaticResource TableHeaderRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource TableHeaderTextStyle}" Text="#" />
                                <TextBlock x:Name="thChannel" Grid.Column="3" Style="{StaticResource TableHeaderTextStyle}" Text="CHANNEL" />
                                <TextBlock x:Name="thSubscribers" Grid.Column="4" Style="{StaticResource TableHeaderTextStyle}" HorizontalAlignment="Right" Text="SUBSCRIBERS" />
                                <TextBlock x:Name="thWeek" Grid.Column="5" Style="{StaticResource TableHeaderTextStyle}" HorizontalAlignment="Right" Text="WEEK" />
                                <TextBlock x:Name="thViews" Grid.Column="6" Style="{StaticResource TableHeaderTextStyle}" HorizontalAlignment="Right" Text="VIEWS" />
                            </Grid>
                        </Border>
                        <StackPanel x:Name="rankingPanel" />
                    </StackPanel>
                </Border>

                <!-- paginação -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Button x:Name="btnPrevPage" Content="‹" MinWidth="36" Click="btnPrevPage_Click" />
                    <TextBlock x:Name="txtPage" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" Margin="14,0" />
                    <Button x:Name="btnNextPage" Content="›" MinWidth="36" Click="btnNextPage_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
