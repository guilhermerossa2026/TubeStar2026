<UserControl x:Class="TubeStar.RivalControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TubeStar" >

    <Grid x:Name="LayoutRoot" Background="#0F0F0F">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#181818" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" Padding="8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <ToggleButton x:Name="btnTier1" Width="100" Content="Tier I" Margin="4,0" IsChecked="True" Click="btnTier1_Click" />
                <ToggleButton x:Name="btnTier2" Width="100" Content="Tier II" Margin="4,0" Click="btnTier2_Click" />
                <ToggleButton x:Name="btnTier3" Width="100" Content="Tier III" Margin="4,0" Click="btnTier3_Click" />
                <ToggleButton x:Name="btnTier4" Width="100" Content="Tier IV" Margin="4,0" Click="btnTier4_Click" />
                <ToggleButton x:Name="btnTier5" Width="100" Content="Tier V" Margin="4,0" Click="btnTier5_Click" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="#181818" BorderBrush="#2A2A2A" BorderThickness="0,0,1,0" Padding="8">
            <ScrollViewer BorderThickness="0" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="channelPanel"/>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#202020" BorderBrush="#383838" BorderThickness="1" CornerRadius="8" Height="48" Margin="0,0,0,8" Padding="6,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnGrid" Grid.Column="0" VerticalAlignment="Center" Height="32" Margin="2" Click="btnGrid_Click" Background="#282828" BorderBrush="#383838" >
                        <Image Source="../Resources/Grid-icon.png" Height="16" />
                    </Button>
                    <Button x:Name="btnList" Grid.Column="1" VerticalAlignment="Center" Height="32" Margin="2" Click="btnList_Click" Background="#282828" BorderBrush="#383838" >
                        <Image Source="../Resources/List-icon.png" Height="16" />
                    </Button>

                    <TextBlock x:Name="channelSummaryTextBlock" Grid.Column="2" FontSize="16" FontWeight="SemiBold" Text="Canal Rival" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#F1F1F1" />
                </Grid>
            </Border>

            <ScrollViewer x:Name="listViewer" Grid.Row="1" BorderThickness="0" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="videoPanel" Orientation="Vertical" />
            </ScrollViewer>

            <ScrollViewer x:Name="gridViewer" Grid.Row="1" BorderThickness="0" VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="videoPanelGrid" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
