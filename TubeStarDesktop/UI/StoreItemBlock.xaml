<UserControl x:Class="TubeStar.StoreItemBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             Width="450" 
             Margin="2"
             Padding="2"
             MouseEnter="UserControl_MouseEnter"
             MouseLeave="UserControl_MouseLeave">

    <Border Background="#1C1C1C" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="6">
        <Grid x:Name="LayoutRoot" Background="Transparent" MouseLeftButtonDown="LayoutRoot_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#252525" CornerRadius="6" Margin="4">
                <Image x:Name="imgItem" Height="140" Width="140" Stretch="Uniform"></Image>
            </Border>

            <StackPanel Grid.Column="1" Margin="8,4,4,4">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="txtName" Grid.Column="0" FontSize="18" Text="" FontWeight="Bold" Foreground="#F1F1F1" TextWrapping="Wrap"></TextBlock>
                    <TextBlock x:Name="txtPrice" Grid.Column="1" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center" Text="" FontWeight="Bold" Foreground="#2BA640" Margin="8,0,0,0"></TextBlock>
                </Grid>
                <TextBlock x:Name="txtDescription" FontSize="14" Text="" Foreground="#AAAAAA" FontStyle="Normal" TextWrapping="Wrap"></TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
