<UserControl x:Class="TubeStar.StoreItemBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             Width="300"
             Margin="0,0,14,14"
             MouseEnter="UserControl_MouseEnter"
             MouseLeave="UserControl_MouseLeave">

    <!-- .card da loja: icone + nome/efeito, depois preco + Comprar/Comprado -->
    <Border x:Name="cardBorder" Style="{StaticResource CardBorderStyle}">
        <Grid x:Name="LayoutRoot" Background="Transparent" MouseLeftButtonDown="LayoutRoot_MouseLeftButtonDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="56" Height="56" CornerRadius="{StaticResource YtCornerRadius}" Background="{StaticResource YtDarkSurfaceBrush}" BorderBrush="{StaticResource YtDarkBorderBrush}" BorderThickness="1" VerticalAlignment="Top">
                    <Grid>
                        <Grid.Clip>
                            <RectangleGeometry Rect="0,0,54,54" RadiusX="9" RadiusY="9" />
                        </Grid.Clip>
                        <Image x:Name="imgItem" Stretch="UniformToFill" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock x:Name="txtName" FontSize="14" FontWeight="Bold" Foreground="{StaticResource YtTextPrimaryBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="txtDescription" Margin="0,4,0,0" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <TextBlock x:Name="txtPrice" FontSize="15" FontWeight="Bold" Foreground="{StaticResource YtTextPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                <Button x:Name="btnBuy" Content="Buy" Style="{StaticResource SmallPrimaryButtonStyle}" HorizontalAlignment="Right" ToolTipService.ShowOnDisabled="True" Click="btnBuy_Click" />
                <Border x:Name="pillPurchased" Style="{StaticResource PillGainStyle}" HorizontalAlignment="Right" Visibility="Collapsed">
                    <TextBlock x:Name="txtPurchased" Style="{StaticResource InheritTextStyle}" Text="Purchased" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
