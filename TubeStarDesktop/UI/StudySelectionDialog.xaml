<xctk:ChildWindow x:Class="TubeStar.StudySelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Caption="Study selection"
        WindowStartupLocation="Center">

    <StackPanel x:Name="LayoutRoot" Width="520">
        <StackPanel x:Name="studyButtonStackPanel" Margin="-6,-6,-6,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnCancel" IsCancel="True" Content="Cancel" Style="{StaticResource GhostButtonStyle}" Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>

</xctk:ChildWindow>
