<UserControl x:Class="TubeStar.VideoBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:n="clr-namespace:Nicenis.Windows;assembly=Nicenis"
             Width="Auto"
             Padding="0"
             Margin="0,0,0,8">

    <!-- .card + .rowv: miniatura 16:9 a esquerda, titulo e numeros, acoes a direita -->
    <Grid x:Name="LayoutRoot" Background="Transparent">
        <Border Style="{StaticResource CardBorderStyle}" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Width="160" Height="90" VerticalAlignment="Center">
                    <Grid.Clip>
                        <RectangleGeometry Rect="0,0,160,90" RadiusX="8" RadiusY="8" />
                    </Grid.Clip>
                    <Rectangle Fill="{StaticResource YtDarkSurfaceBrush}" />
                    <Image x:Name="imgVideo" Cursor="Hand" MouseLeftButtonDown="imgVideo_MouseLeftButtonDown" Stretch="UniformToFill" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,10,0">
                    <TextBlock x:Name="txtName" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource YtTextPrimaryBrush}" Text="Blah Blah" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />

                    <TextBlock x:Name="txtViews" Text="Blah Blah" FontSize="12" Foreground="{StaticResource YtTextSecondaryBrush}" Margin="0,4,0,4" />

                    <StackPanel x:Name="panelStats" Orientation="Horizontal">
                        <Image x:Name="imgLikes" Height="13" Source="../Resources/Likes.png" Opacity="0.7" VerticalAlignment="Center" />
                        <TextBlock x:Name="txtLikes" Text="Blah Blah" FontSize="12" Foreground="{StaticResource YtTextSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,12,0" />
                        <Image x:Name="imgDislikes" Height="13" Source="../Resources/Dislikes.png" Opacity="0.7" VerticalAlignment="Center" />
                        <TextBlock x:Name="txtDislikes" Text="Blah Blah" FontSize="12" Foreground="{StaticResource YtTextSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid x:Name="qualityGrid" Height="34" Width="34" Margin="0,0,10,0">
                        <Border Background="{StaticResource YtRedBrush}" CornerRadius="6" />
                        <TextBlock x:Name="txtQuality" FontSize="15" FontWeight="Bold" Text="99" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource YtOnAccentBrush}"/>
                    </Grid>
                    <Button x:Name="btnUpload" Content="Upload" Style="{StaticResource SmallPrimaryButtonStyle}" VerticalAlignment="Center" Margin="0,0,6,0" Click="btnUpload_Click"/>
                    <Button x:Name="btnComments" Content="Comments" Style="{StaticResource SmallButtonStyle}" VerticalAlignment="Center" Margin="0,0,6,0" Click="btnComments_Click" />
                    <Button x:Name="btnDelete" Style="{StaticResource GhostButtonStyle}" MinHeight="0" Padding="7" VerticalAlignment="Center" Click="btnDelete_Click">
                        <Image Source="../Resources/Delete_icon.png" Height="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="SuspendedAdorner" Visibility="Collapsed" MouseLeftButtonDown="SuspendedAdorner_MouseLeftButtonDown">
            <Border Background="Black" Opacity="0.7" CornerRadius="{StaticResource YtCornerRadius}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="txtSuspended" Text="SUSPENDED" FontSize="20" FontWeight="Bold" Foreground="{StaticResource YtLossBrush}" TextAlignment="Center" />
                <TextBlock x:Name="txtSuspendedSub" Text="(Click to Hire Lawyer)" FontSize="12" TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
