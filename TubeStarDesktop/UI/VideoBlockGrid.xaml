<UserControl x:Class="TubeStar.VideoBlockGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:n="clr-namespace:Nicenis.Windows;assembly=Nicenis"
             Width="288"
             Padding="0"
             Margin="0,0,12,12"
             Cursor="Hand"
             MouseEnter="UserControl_MouseEnter"
             MouseLeave="UserControl_MouseLeave"
             PreviewMouseUp="UserControl_PreviewMouseUp"
             n:DragSource.AllowDrag="True"
             n:DragSource.Data="{Binding}"
             n:DragSource.VisualFeedbackOffset="{Binding (n:DragSource.ContactPosition), RelativeSource={RelativeSource Self}}">

    <!-- .card.vcard -->
    <Grid x:Name="LayoutRoot">
        <Border x:Name="cardBorder" Style="{StaticResource CardBorderStyle}" Padding="10">
            <StackPanel>
                <!-- .thumb 16:9 com selo de views -->
                <Grid Height="151">
                    <Grid.Clip>
                        <RectangleGeometry Rect="0,0,266,151" RadiusX="8" RadiusY="8" />
                    </Grid.Clip>
                    <Rectangle Fill="{StaticResource YtDarkSurfaceBrush}" />
                    <Image x:Name="imgVideo" Stretch="UniformToFill" />

                    <Grid x:Name="topGrid">
                        <Grid x:Name="qualityGrid" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Width="30" Height="30">
                            <Border Background="{StaticResource YtRedBrush}" CornerRadius="6" />
                            <TextBlock x:Name="txtQuality" FontSize="14" FontWeight="Bold" Text="99" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource YtOnAccentBrush}" />
                        </Grid>
                        <Border x:Name="viewsBadge" Style="{StaticResource ThumbBadgeStyle}">
                            <TextBlock x:Name="txtViews" FontSize="11" Foreground="{StaticResource YtOnAccentBrush}" />
                        </Border>
                    </Grid>
                </Grid>

                <!-- titulo + numeros -->
                <StackPanel x:Name="bottomGrid">
                    <TextBlock x:Name="txtName" Margin="0,8,0,4" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource YtTextPrimaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <StackPanel x:Name="panelStats" Orientation="Horizontal">
                        <Image Source="../Resources/Likes.png" Height="13" Opacity="0.7" VerticalAlignment="Center" />
                        <TextBlock x:Name="txtLikes" FontSize="12" Foreground="{StaticResource YtTextSecondaryBrush}" Margin="4,0,12,0" VerticalAlignment="Center" />
                        <Image Source="../Resources/Dislikes.png" Height="13" Opacity="0.7" VerticalAlignment="Center" />
                        <TextBlock x:Name="txtDislikes" FontSize="12" Foreground="{StaticResource YtTextSecondaryBrush}" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid x:Name="SuspendedAdorner" Visibility="Collapsed" MouseLeftButtonDown="SuspendedAdorner_MouseLeftButtonDown">
            <Border Background="Black" Opacity="0.7" CornerRadius="{StaticResource YtCornerRadius}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="../Resources/Sad_icon.png" Height="36" Margin="3,0,3,4" />
                <TextBlock x:Name="txtSuspended" Text="SUSPENDED" FontSize="20" FontWeight="Bold" Foreground="{StaticResource YtLossBrush}" TextAlignment="Center" />
                <TextBlock x:Name="txtSuspendedSub" Text="(Click to Hire Lawyer)" FontSize="13" Foreground="{StaticResource YtTextPrimaryBrush}" TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
