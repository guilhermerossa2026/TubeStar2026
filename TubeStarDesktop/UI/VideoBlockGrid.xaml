<UserControl x:Class="TubeStar.VideoBlockGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Padding="0"
             Margin="0,0,12,12"
             Cursor="Hand"
             MouseEnter="UserControl_MouseEnter"
             MouseLeave="UserControl_MouseLeave"
             MouseLeftButtonUp="UserControl_MouseLeftButtonUp">

    <!-- .card.vcard -->
    <Grid x:Name="LayoutRoot">
        <Border x:Name="cardBorder" Style="{StaticResource CardBorderStyle}" Padding="10">
            <StackPanel>
                <!-- .thumb 16:9 com selo de views -->
                <Grid x:Name="thumbGrid" Height="151" SizeChanged="thumbGrid_SizeChanged">
                    <Rectangle Fill="{StaticResource YtDarkSurfaceBrush}" />
                    <Image x:Name="imgVideo" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <!-- selo de sorte (VIRAL / EM ALTA / FLOPOU) -->
                    <Border x:Name="luckBadge" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Padding="6,2" CornerRadius="4">
                        <TextBlock x:Name="txtLuckBadge" FontSize="11" FontWeight="Bold" Foreground="White" />
                    </Border>
                </Grid>

                <!-- titulo -->
                <TextBlock x:Name="txtName" Margin="0,8,0,6" FontSize="14" FontWeight="Bold" Foreground="{StaticResource YtTextPrimaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />

                <!-- views + nota -->
                <Grid MinHeight="20">
                    <TextBlock x:Name="txtViewsLine" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <Border x:Name="scorePill" Style="{StaticResource PillSoftStyle}" HorizontalAlignment="Right">
                        <TextBlock x:Name="txtScore" Style="{StaticResource InheritTextStyle}" />
                    </Border>
                </Grid>

                <!-- likes, dislikes, comentarios e dias no ar: sempre numa linha; encolhe em vez de quebrar -->
                <Viewbox x:Name="panelStats" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="13" Height="13"  VerticalAlignment="Center" SnapsToDevicePixels="True" UseLayoutRounding="True"><Canvas Width="256" Height="256"><Path Data="{StaticResource IconThumbUp}" Fill="{StaticResource YtTextSecondaryBrush}" Stretch="None" /></Canvas></Viewbox>
                    <TextBlock x:Name="txtLikes" Style="{StaticResource MutedTextStyle}" Margin="5,0,12,0" VerticalAlignment="Center" />
                    <Viewbox Width="13" Height="13"  VerticalAlignment="Center" SnapsToDevicePixels="True" UseLayoutRounding="True"><Canvas Width="256" Height="256"><Path Data="{StaticResource IconThumbDown}" Fill="{StaticResource YtTextSecondaryBrush}" Stretch="None" /></Canvas></Viewbox>
                    <TextBlock x:Name="txtDislikes" Style="{StaticResource MutedTextStyle}" Margin="5,0,12,0" VerticalAlignment="Center" />
                    <Viewbox Width="13" Height="13"  VerticalAlignment="Center" SnapsToDevicePixels="True" UseLayoutRounding="True"><Canvas Width="256" Height="256"><Path Data="{StaticResource IconComment}" Fill="{StaticResource YtTextSecondaryBrush}" Stretch="None" /></Canvas></Viewbox>
                    <TextBlock x:Name="txtComments" Style="{StaticResource MutedTextStyle}" Margin="5,0,12,0" VerticalAlignment="Center" />
                    <Viewbox Width="13" Height="13"  VerticalAlignment="Center" SnapsToDevicePixels="True" UseLayoutRounding="True"><Canvas Width="256" Height="256"><Path Data="{StaticResource IconCalendar}" Fill="{StaticResource YtTextSecondaryBrush}" Stretch="None" /></Canvas></Viewbox>
                    <TextBlock x:Name="txtDays" Style="{StaticResource MutedTextStyle}" Margin="5,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                </Viewbox>

                <!-- acoes -->
                <Grid Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnDelete" Style="{StaticResource GhostButtonStyle}" FontSize="12" Padding="9,3" MinHeight="0" Content="Delete" Click="btnDelete_Click" />
                        <Button x:Name="btnUpload" Style="{StaticResource SmallPrimaryButtonStyle}" FontSize="12" Padding="10,3" Margin="6,0,0,0" Content="Post" Click="btnUpload_Click" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Grid x:Name="SuspendedAdorner" Visibility="Collapsed" MouseLeftButtonDown="SuspendedAdorner_MouseLeftButtonDown">
            <Border Background="Black" Opacity="0.7" CornerRadius="{StaticResource YtCornerRadius}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Viewbox Width="36" Height="36" Margin="3,0,3,4"  SnapsToDevicePixels="True" UseLayoutRounding="True"><Canvas Width="256" Height="256"><Path Data="{StaticResource IconSad}" Fill="{StaticResource YtTextPrimaryBrush}" Stretch="None" /></Canvas></Viewbox>
                <TextBlock x:Name="txtSuspended" Text="SUSPENDED" FontSize="20" FontWeight="Bold" Foreground="{StaticResource YtLossBrush}" TextAlignment="Center" />
                <TextBlock x:Name="txtSuspendedSub" Text="(Click to Hire Lawyer)" FontSize="13" Foreground="{StaticResource YtTextPrimaryBrush}" TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
