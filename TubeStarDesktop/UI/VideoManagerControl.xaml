<UserControl x:Class="TubeStar.VideoManagerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TubeStar" >

    <Grid x:Name="LayoutRoot" Background="{StaticResource YtDarkBgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource YtDarkSurfaceBrush}" BorderBrush="{StaticResource YtDarkCardBrush}" BorderThickness="0,0,1,0" Padding="8">
            <Grid>
                <Button x:Name="btnAddChannel" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="36" Click="AddChannel_Click" Background="{StaticResource YtDarkCardHoverBrush}" BorderBrush="{StaticResource YtDarkBorderBrush}">
                    <Button.Content>
                        <WrapPanel VerticalAlignment="Center">
                            <Image Source="/Resources/Add_icon.png" Margin="0,0,8,0" Height="14" />
                            <TextBlock x:Name="txtAddChannel" Text="Add Channel" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </WrapPanel>
                    </Button.Content>
                </Button>

                <ScrollViewer Margin="0,48,0,0" BorderThickness="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="channelPanel"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource YtDarkCardBrush}" BorderBrush="{StaticResource YtDarkBorderBrush}" BorderThickness="1" CornerRadius="8" Height="48" Margin="0,0,0,8" Padding="6,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="42"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnGrid" Grid.Column="0" VerticalAlignment="Center" Height="32" Margin="2" Click="btnGrid_Click" Background="{StaticResource YtDarkCardHoverBrush}" BorderBrush="{StaticResource YtDarkBorderBrush}" >
                        <Image Source="../Resources/Grid-icon.png" Height="16" />
                    </Button>
                    <Button x:Name="btnList" Grid.Column="1" VerticalAlignment="Center" Height="32" Margin="2" Click="btnList_Click" Background="{StaticResource YtDarkCardHoverBrush}" BorderBrush="{StaticResource YtDarkBorderBrush}" >
                        <Image Source="../Resources/List-icon.png" Height="16" />
                    </Button>

                    <TextBlock Grid.Column="2" x:Name="channelSummaryTextBlock" FontSize="16" FontWeight="SemiBold" Text="Canal" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource YtTextPrimaryBrush}" />
                    <Button x:Name="btnStats" Grid.Column="3" VerticalAlignment="Center" Height="32" Margin="2" Click="btnStats_Click" Background="{StaticResource YtDarkCardHoverBrush}" BorderBrush="{StaticResource YtDarkBorderBrush}">
                        <Image Source="../Resources/Graph.png" />
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer x:Name="listViewer" Grid.Row="1" BorderThickness="0" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="videoPanel" Orientation="Vertical" />
            </ScrollViewer>

            <ScrollViewer x:Name="gridViewer" Grid.Row="1" BorderThickness="0" VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="videoPanelGrid" />
            </ScrollViewer>

            <Grid x:Name="binGrid" Background="Transparent" Grid.Row="2" AllowDrop="True" Drop="binGrid_Drop" DragEnter="binGrid_DragEnter" DragLeave="binGrid_DragLeave" HorizontalAlignment="Stretch" Margin="2">
                <Rectangle StrokeDashArray="1 1 1" Stroke="{StaticResource YtTextSecondaryBrush}" StrokeThickness="2"/>
                <Image Source="../Resources/Trash.png" Height="24" Margin="2" HorizontalAlignment="Center" />
            </Grid>

        </Grid>
    </Grid>
</UserControl>
