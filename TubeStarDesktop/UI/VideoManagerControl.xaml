<UserControl x:Class="TubeStar.VideoManagerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TubeStar" >

        <UserControl.Resources>
        <!-- Rótulo e número do painel do canal (mesmo tamanho em todos os blocos) -->
        <Style x:Key="PanelKpiLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource KpiLabelStyle}">
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="PanelKpiValueStyle" TargetType="TextBlock" BasedOn="{StaticResource KpiValueStyle}">
            <Setter Property="FontSize" Value="20" />
        </Style>
    </UserControl.Resources>
    <Grid x:Name="LayoutRoot" Background="{StaticResource YtDarkBgBrush}">
        <Grid Margin="24,20,24,12" MaxWidth="1400" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Titulo + lead -->
            <StackPanel Grid.Row="0">
                <TextBlock x:Name="txtTitle" Style="{StaticResource PageTitleStyle}" Text="My videos" />
                <TextBlock x:Name="txtLead" Style="{StaticResource PageLeadStyle}" />
            </StackPanel>

            <!-- Chips de canal + Novo canal -->
            <Grid Grid.Row="1" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel x:Name="channelChips" Grid.Column="0" VerticalAlignment="Center" />
                <Button x:Name="btnAddChannel" Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Top" Margin="12,0,0,8" Content="+ New channel" Click="AddChannel_Click" />
            </Grid>

            <!-- Filtros + busca + ver todos -->
            <Grid Grid.Row="2" Margin="0,4,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <Button x:Name="btnFilterRecent" Style="{StaticResource ChipActiveButtonStyle}" Content="Most recent" Click="Filter_Click" />
                    <Button x:Name="btnFilterViews" Style="{StaticResource ChipButtonStyle}" Content="Most viewed" Click="Filter_Click" />
                    <Button x:Name="btnFilterScore" Style="{StaticResource ChipButtonStyle}" Content="Best score" Click="Filter_Click" />
                </WrapPanel>
                <Grid Grid.Column="1" Width="220" VerticalAlignment="Top" Margin="12,0,0,8">
                    <TextBox x:Name="txtSearch" Padding="10,6" Background="{StaticResource YtDarkSurfaceBrush}" BorderBrush="{StaticResource YtDarkBorderBrush}" Foreground="{StaticResource YtTextPrimaryBrush}" CaretBrush="{StaticResource YtTextPrimaryBrush}" VerticalContentAlignment="Center" TextChanged="txtSearch_TextChanged" AutomationProperties.Name="Search video" />
                    <TextBlock x:Name="txtSearchPlaceholder" Style="{StaticResource MutedTextStyle}" FontSize="13" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Text="Search video" />
                </Grid>
                <Button x:Name="btnViewAll" Grid.Column="2" Style="{StaticResource ChipButtonStyle}" VerticalAlignment="Top" Margin="8,0,0,8" Content="View all" Click="btnViewAll_Click" />
            </Grid>

            <!-- Grade + painel -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <ScrollViewer x:Name="gridViewer" Grid.Column="0" BorderThickness="0" VerticalScrollBarVisibility="Auto" SizeChanged="gridViewer_SizeChanged">
                    <StackPanel Margin="0,0,4,0">
                        <UniformGrid x:Name="videoPanelGrid" Columns="3" VerticalAlignment="Top" />
                        <TextBlock x:Name="txtEmpty" Style="{StaticResource MutedTextStyle}" FontSize="14" Margin="0,24" HorizontalAlignment="Center" Visibility="Collapsed" />
                        <StackPanel x:Name="pagerPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,8">
                            <Button x:Name="btnPrev" Style="{StaticResource SmallButtonStyle}" Content="‹ Previous" Click="btnPrev_Click" />
                            <TextBlock x:Name="txtPage" Style="{StaticResource MutedTextStyle}" FontSize="13" Margin="14,0" VerticalAlignment="Center" />
                            <Button x:Name="btnNext" Style="{StaticResource SmallButtonStyle}" Content="Next ›" Click="btnNext_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Painel do canal -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" BorderThickness="0" Margin="12,0,0,0">
                <Border Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock x:Name="txtPanelTitle" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock x:Name="txtPanelNiche" Style="{StaticResource MutedTextStyle}" Margin="0,2,0,0" />
                        <TextBlock x:Name="txtPanelStatus" Style="{StaticResource MutedTextStyle}" Foreground="{StaticResource YtLossBrush}" FontWeight="Bold" Margin="0,4,0,0" Visibility="Collapsed" />

                        <StackPanel x:Name="panelKpis" Margin="0,2,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,12,8,0">
                                    <TextBlock x:Name="lblViews" Style="{StaticResource PanelKpiLabelStyle}" />
                                    <TextBlock x:Name="txtKpiViews" Style="{StaticResource PanelKpiValueStyle}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,12,0,0">
                                    <TextBlock x:Name="lblIncome" Style="{StaticResource PanelKpiLabelStyle}" />
                                    <TextBlock x:Name="txtKpiIncome" Style="{StaticResource PanelKpiValueStyle}" Foreground="{StaticResource YtGainBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,8,0">
                                    <TextBlock x:Name="lblSubs" Style="{StaticResource PanelKpiLabelStyle}" />
                                    <TextBlock x:Name="txtKpiSubs" Style="{StaticResource PanelKpiValueStyle}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="lblRpm" Style="{StaticResource PanelKpiLabelStyle}" VerticalAlignment="Center" />
                                        <Border x:Name="rpmHelp" Width="13" Height="13" CornerRadius="7" Margin="5,0,0,2" BorderBrush="{StaticResource YtTextSecondaryBrush}" BorderThickness="1" Background="Transparent" VerticalAlignment="Center" Cursor="Help">
                                            <TextBlock Text="?" FontSize="9" FontWeight="Bold" Foreground="{StaticResource YtTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="txtKpiRpm" Style="{StaticResource PanelKpiValueStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Viewbox Width="12" Height="12" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding Visibility, ElementName=iconRpmLock}" SnapsToDevicePixels="True" UseLayoutRounding="True"><Canvas Width="256" Height="256"><Path x:Name="iconRpmLock" Data="{StaticResource IconLock}" Fill="{StaticResource YtTextSecondaryBrush}" Visibility="Collapsed" Stretch="None" /></Canvas></Viewbox>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,12,8,0">
                                    <TextBlock x:Name="lblRank" Style="{StaticResource PanelKpiLabelStyle}" />
                                    <TextBlock x:Name="txtKpiRank" Style="{StaticResource PanelKpiValueStyle}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- monetização (canal escolhido) -->
                        <StackPanel x:Name="panelMonetization" Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center" SnapsToDevicePixels="True" UseLayoutRounding="True"><Canvas Width="256" Height="256"><Path x:Name="iconMonetization" Data="{StaticResource IconLock}" Fill="{StaticResource YtTextSecondaryBrush}" Stretch="None" /></Canvas></Viewbox>
                                <TextBlock x:Name="lblMonetization" Style="{StaticResource KpiLabelStyle}" Margin="0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel x:Name="panelMonetizationGoal">
                                <TextBlock x:Name="txtMonSubs" Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,6,0,2" />
                                <ProgressBar x:Name="barMonSubs" Height="6" Minimum="0" Maximum="1" BorderThickness="0" Background="{StaticResource YtDarkBorderBrush}" Foreground="{StaticResource YtRedBrush}" />
                                <TextBlock x:Name="txtMonViews" Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,6,0,2" />
                                <ProgressBar x:Name="barMonViews" Height="6" Minimum="0" Maximum="1" BorderThickness="0" Background="{StaticResource YtDarkBorderBrush}" Foreground="{StaticResource YtRedBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="txtMonStatus" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <Button x:Name="btnMonRequest" Style="{StaticResource PrimaryButtonStyle}" Margin="0,8,0,0" Click="btnMonRequest_Click" />
                        </StackPanel>

                        <StackPanel Margin="0,14,0,0">
                            <TextBlock x:Name="lblVideos" Style="{StaticResource PanelKpiLabelStyle}" />
                            <TextBlock x:Name="txtKpiVideos" Style="{StaticResource PanelKpiValueStyle}" />
                        </StackPanel>

                        <!-- Visão geral: uma linha por canal -->
                        <StackPanel x:Name="panelOverview" Margin="0,8,0,0" />

                        <TextBlock x:Name="txtUnreleasedHint" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,12,0,0" />

                        <StackPanel x:Name="panelChannelButtons" Margin="0,14,0,0">
                            <Button x:Name="btnStats" Style="{StaticResource SmallButtonStyle}" Padding="9,6" Content="Statistics" Click="btnStats_Click" />
                            <Button x:Name="btnEdit" Style="{StaticResource SmallButtonStyle}" Padding="9,6" Margin="0,6,0,0" Content="Edit channel" Click="btnEdit_Click" />
                            <Button x:Name="btnDeleteChannel" Style="{StaticResource GhostButtonStyle}" Padding="9,6" Margin="0,6,0,0" Content="Delete channel" Click="btnDeleteChannel_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
