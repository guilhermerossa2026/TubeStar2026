<xctk:ChildWindow x:Class="TubeStar.ViewVideoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:TubeStar"
        Caption="View Video"
        WindowStartupLocation="Center"
        Closed="ChildWindow_Closed">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="Black" BorderBrush="{StaticResource YtDarkBorderBrush}" BorderThickness="1" Padding="0">
            <WebBrowser x:Name="webView" LoadCompleted="wb_LoadCompleted" Width="640" Height="360" />
        </Border>

        <DockPanel Grid.Row="1" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="lblComments" DockPanel.Dock="Left" Text="Comments" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button x:Name="btnOk" DockPanel.Dock="Right" Content="OK" MinWidth="100" IsDefault="True" IsCancel="True" Style="{StaticResource PrimaryButtonStyle}" Click="OKButton_Click"/>
        </DockPanel>
    </Grid>

</xctk:ChildWindow>
