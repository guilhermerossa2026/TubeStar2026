<xctk:ChildWindow x:Class="TubeStar.ViewVideoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:TubeStar"
        Caption="View Video"
        WindowStartupLocation="Center">

    <!-- Análise do vídeo: cabeçalho + abas Desempenho e Dinheiro (os números simples ficam no cartão) -->
    <StackPanel Width="640">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Width="256" Height="144" CornerRadius="8" Background="{StaticResource YtDarkSurfaceBrush}" BorderBrush="{StaticResource YtDarkBorderBrush}" BorderThickness="1" ClipToBounds="True">
                <Image x:Name="imgVideo" Stretch="UniformToFill" />
            </Border>

            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock x:Name="txtName" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock x:Name="txtChannel" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                <Border x:Name="scorePill" Style="{StaticResource PillSoftStyle}" HorizontalAlignment="Left" Margin="0,10,0,0">
                    <TextBlock x:Name="txtScore" Style="{StaticResource InheritTextStyle}" />
                </Border>
                <TextBlock x:Name="txtProfitHeader" FontWeight="SemiBold" Margin="0,10,0,0" />
            </StackPanel>
        </Grid>

        <!-- abas -->
        <StackPanel Orientation="Horizontal" Margin="0,16,0,8">
            <Button x:Name="btnTabPerformance" Click="btnTabPerformance_Click" />
            <Button x:Name="btnTabMoney" Click="btnTabMoney_Click" />
        </StackPanel>

        <Border Style="{StaticResource CardBorderStyle}">
            <Grid>
                <StackPanel x:Name="panelPerformance">
                    <UniformGrid x:Name="performanceKpis" Columns="4" />
                    <TextBlock x:Name="txtWhyScore" FontWeight="Bold" Margin="0,14,0,8" />
                    <StackPanel x:Name="qualityRows" />
                    <TextBlock x:Name="txtAttributes" Style="{StaticResource MutedTextStyle}" Margin="0,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel x:Name="panelMoney" Visibility="Collapsed">
                    <UniformGrid x:Name="moneyKpis" Columns="3" />
                    <TextBlock x:Name="txtMoneyNote" Style="{StaticResource MutedTextStyle}" Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="btnOk" Content="OK" MinWidth="100" IsDefault="True" IsCancel="True" Style="{StaticResource PrimaryButtonStyle}" Click="OKButton_Click"/>
        </StackPanel>
    </StackPanel>

</xctk:ChildWindow>
